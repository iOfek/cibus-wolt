# Cibus
CIBUS_USER=your-cibus-username
CIBUS_PASS=your-cibus-permanent-password
CIBUS_COMPANY=your-company-name-on-cibus
# "password" (default) or "otp" — OTP uses Gmail to auto-fetch the code (requires phone-forwarding automation to "cibus-otp" subject)
CIBUS_AUTH_MODE=password

# Wolt
WOLT_EMAIL=your-wolt-email@example.com

# Google OAuth (Desktop app client - PKCE)
# Get this from console.cloud.google.com -> Credentials -> OAuth Client ID (Desktop)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Safety
MIN_AMOUNT=10
MAX_SPEND=1200

# MCP (for phone access via Claude; leave empty to disable)
MCP_BEARER_TOKEN=change-me
MCP_PORT=3737

# Optional
DRY_RUN=0
LOG_LEVEL=info
